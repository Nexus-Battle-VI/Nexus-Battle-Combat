# Configuracion del servicio Combat.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-combat
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3006
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI en /api/docs. Deshabilitada en produccion
# por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory:   doble en proceso para desarrollo y pruebas. PROHIBIDO en produccion.
# mongo: MongoDB real; exige MONGODB_URI.
PERSISTENCE_DRIVER=memory
MONGODB_URI=

# --- Autenticacion --------------------------------------------------------
# disabled: se atribuye la identidad `anonymous`. Con NODE_ENV=production el
#           servicio NO ARRANCA en este modo (ADR-004).
# jwt:      se exige un testimonio de acceso firmado por el user pool.
AUTH_MODE=disabled

# No son secretos: el identificador del cliente publico viaja en la URL de
# inicio de sesion. Son los valores reales del pool aprovisionado.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Contrato interno entre servicios -------------------------------------
# Secreto HMAC compartido para `/api/internal/v1/...`. Sin el, las rutas
# internas responden 503. Consumidores autorizados (ADR-019): missions.
INTERNAL_SERVICE_AUTH_SECRET=

# --- Chat del lobby y de las salas (HU-13) --------------------------------
# ADR-020 delega en HU-13 la longitud y la frecuencia; la Historia no da cifras.
# Los valores por defecto son la propuesta que el PO ratifico por chat (no consta
# por escrito en el issue). CHAT_RETENTION_HOURS (7 dias) NO tiene ninguna fuente:
# el PO debe fijarla. Todo esto es configuracion, no constantes.
# Longitud maxima del texto, en puntos de codigo Unicode (1..2000).
CHAT_MAX_MESSAGE_LENGTH=500
# Mensajes permitidos por remitente y canal dentro de la ventana (1..100).
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW_MS=10000
# Cuanto tiempo se conserva un mensaje persistido (horas, 1..8760).
CHAT_RETENTION_HOURS=168
# Mensajes que recibe quien se suscribe (1..200).
CHAT_HISTORY_LIMIT=50
