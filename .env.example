# Configuracion del servicio Combat.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-combat
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3006
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI en /api/docs. Deshabilitada en produccion
# por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory:   doble en proceso para desarrollo y pruebas. PROHIBIDO en produccion.
# mongo: MongoDB real; exige MONGODB_URI.
PERSISTENCE_DRIVER=memory
MONGODB_URI=

# --- Autenticacion --------------------------------------------------------
# disabled: se atribuye la identidad `anonymous`. Con NODE_ENV=production el
#           servicio NO ARRANCA en este modo (ADR-004).
# jwt:      se exige un testimonio de acceso firmado por el user pool.
AUTH_MODE=disabled

# No son secretos: el identificador del cliente publico viaja en la URL de
# inicio de sesion. Son los valores reales del pool aprovisionado.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Contrato interno entre servicios -------------------------------------
# Secreto HMAC compartido para `/api/internal/v1/...`. Sin el, las rutas
# internas responden 503. Consumidores autorizados (ADR-019): missions.
INTERNAL_SERVICE_AUTH_SECRET=

# URL interna de Catalog para obtener candidatos gameplay de bots (HU-93.1).
CATALOG_SERVICE_BASE_URL=http://catalog:3003

# --- Chat del lobby y de las salas (HU-13) --------------------------------
# ADR-020 delega en HU-13 la longitud y la frecuencia; la Historia no da cifras.
# Los valores por defecto son la propuesta que el PO ratifico por chat (no consta
# por escrito en el issue). CHAT_RETENTION_HOURS (7 dias) NO tiene ninguna fuente:
# el PO debe fijarla. Todo esto es configuracion, no constantes.
# Longitud maxima del texto, en puntos de codigo Unicode (1..2000).
CHAT_MAX_MESSAGE_LENGTH=500
# Mensajes permitidos por remitente y canal dentro de la ventana (1..100).
CHAT_RATE_LIMIT_MESSAGES=5
CHAT_RATE_LIMIT_WINDOW_MS=10000
# Cuanto tiempo se conserva un mensaje persistido (horas, 1..8760).
CHAT_RETENTION_HOURS=168
# Mensajes que recibe quien se suscribe (1..200).
CHAT_HISTORY_LIMIT=50

# --- Teacher labels MCTS en vivo (EN-036.2, Management #566) --------------
# Genera un `MctsTeacherLabel` real por cada decision HUMAN/AI (ONLINE,
# TOURNAMENT): ejecuta una busqueda MCTS completa (128 rollouts) en segundo
# plano, aislada del RNG de produccion y sin anadir latencia a la respuesta
# (fail-open: un fallo nunca afecta el combate real). Costo de CPU
# significativo por decision -- debe habilitarse deliberadamente para
# alimentar el pipeline de dataset de `ai/`, nunca por defecto.
MCTS_LIVE_TEACHER_LABELING_ENABLED=false

# --- NeuralPolicy / ONNX Runtime (EN-036.4, Management #568) --------------
# Activa `NeuralPolicy` como primaria de `DecisionPolicySelector` (el
# fallback SIEMPRE sigue siendo `RuleBasedPolicy`). Deshabilitado por
# defecto: el deploy actual sigue exactamente igual que antes de #568, no
# exige un modelo al arrancar, y evita activar por accidente el artefacto
# SMOKE_TEST de #567 (ningun dataset real suficiente existe todavia). Un
# fallo de carga (archivo ausente, hash/schema incompatible, runtime nativo
# no disponible) deja `RuleBasedPolicy` como unica politica -- el servicio
# arranca igual, nunca se cae por esto.
NEURAL_POLICY_ENABLED=false

# Rutas LOCALES explicitas al artefacto de un training run de #567
# (`model.onnx` + `training-manifest.json` del MISMO run -- nunca archivos
# sueltos de corridas distintas). File-based v1: no hay descarga automatica
# ni model registry (eso es EN-037). Solo se leen si NEURAL_POLICY_ENABLED
# es true; nunca secretos.
NEURAL_MODEL_ONNX_PATH=
NEURAL_MODEL_MANIFEST_PATH=

# Timeout de la inferencia UNICAMENTE (nunca del encoding ni de la carga del
# modelo, ya precargada en bootstrap). 100 ms es un margen generoso medido
# contra el spike real: la MLP de #567 (6785 parametros) midio p50=0ms/
# p95=1ms con 1-3 candidatos (ver docs/en-036-neural-runtime.md).
NEURAL_INFERENCE_TIMEOUT_MS=100

# Permite cargar un artefacto `artifactPurpose=SMOKE_TEST` (todo lo que
# produce #567 hoy) fuera de produccion -- NODE_ENV=production SIEMPRE lo
# rechaza sin importar este valor. Solo para dev/CI, nunca en un entorno
# real.
NEURAL_ALLOW_SMOKE_MODEL=false
